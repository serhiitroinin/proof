{
  "name": "proof",
  "private": true,
  "license": "MIT",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5197 --strictPort --host 127.0.0.1",
    "build": "tsc -b && pnpm registry:build && vite build",
    "registry": "node scripts/registry.ts",
    "contrast": "node scripts/contrast.ts",
    "registry:build": "node scripts/registry.ts && shadcn build --output public/r",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write \"**/*.{ts,tsx,css}\"",
    "preview": "vite preview --port 5191"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "culori": "^4.0.2",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shadcn/lint": "^0.2.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  }
}
